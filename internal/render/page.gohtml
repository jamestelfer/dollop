<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="{{.FaviconPath}}">
<link rel="stylesheet" href="{{.CSSPath}}">
<link rel="stylesheet" href="{{.ThemeCSSPath}}">
<link rel="stylesheet" href="{{.HighlightCSSPath}}">
<style>
{{.FontFaceCSS}}
body { margin: 0; padding-top: 2.5rem; background-color: #ffffff; }
@media (prefers-color-scheme: dark) { body { background-color: #0d1117; } }
.markdown-body { background-color: transparent; }

.page-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  padding: 0.4rem 1rem;
  background-color: #ffffff;
  border-bottom: 1px solid #d0d7de;
}
@media (prefers-color-scheme: dark) {
  .page-header { background-color: #0d1117; border-bottom-color: #30363d; }
}
.page-header img {
  height: 100%;
}
@supports (height: stretch) {
  .page-header img { height: stretch; }
}
.page-header a {
  display: inline-block;
  padding: 0.2rem 0.5rem;
  border: 1px solid #d0d7de;
  border-radius: 4px;
  font-family: monospace;
  font-size: 0.85rem;
  color: #57606a;
  text-decoration: none;
  line-height: 1.4em;
  height: 1.4em;
  vertical-align: baseline;
  font-weight: 900;
}
@media (prefers-color-scheme: dark) {
  .page-header a { border-color: #30363d; color: #8b949e; }
}
.page-header a:hover { border-color: var(--dollop-accent); color: var(--dollop-accent); }

.page-content {
  max-width: 46rem;
  margin: 0 auto;
  padding: 2rem 1.5rem 6rem;
}

.markdown-body .anchor {
  font-size: 1rem;
  float: unset;
  margin-left: unset;
}

.markdown-body a.d2 img { max-width: 100%; height: auto; }
</style>
{{- /* Inter is the fallback body font. It is requested only when the shared
body font fails to load, so pages that have it make no third-party requests
and the stylesheet never blocks rendering. */}}
<script>
(function () {
  function loadInter() {
    var link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap";
    document.head.appendChild(link);
  }
  if (!document.fonts || !document.fonts.load) { loadInter(); return; }
  document.fonts.load('1em "{{.FontFamily}}"').then(function (faces) {
    var loaded = faces.length > 0 && faces.every(function (f) { return f.status === "loaded"; });
    if (!loaded) loadInter();
  }, loadInter);
})();
</script>
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"></noscript>
</head>
<body>
<header class="page-header">
  <a href="{{.SourcePath}}">M&#x2193;</a>
  <a href="https://github.com/jamestelfer/dollop"><picture>
    <source media="(prefers-color-scheme: dark)" srcset="{{.LogoDarkPath}}">
    <img src="{{.LogoLightPath}}" alt="dollop logo">
  </picture></a>
</header>
<div class="page-content">
<div class="markdown-body">
{{.Body}}
</div>
</div>
{{- if .MermaidScript}}
{{.MermaidScript}}
{{- end}}
</body>
</html>
