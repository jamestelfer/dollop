<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="{{.FaviconPath}}">
<link rel="stylesheet" href="{{.CSSPath}}">
<link rel="stylesheet" href="{{.ThemeCSSPath}}">
<link rel="stylesheet" href="{{.LayoutCSSPath}}">
<link rel="stylesheet" href="{{.HighlightCSSPath}}">
{{- with .FontStylesheet}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{.}}">
{{- end}}
{{- if .FontFamily}}
<style>
{{.FontFaceCSS}}
</style>
{{- /* Inter is the fallback body font. It is requested only when the shared
body font fails to load, so pages that have it make no third-party requests
and the stylesheet never blocks rendering. */}}
<script>
(function () {
  function loadInter() {
    var link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap";
    document.head.appendChild(link);
  }
  if (!document.fonts || !document.fonts.load) { loadInter(); return; }
  document.fonts.load('1em "{{.FontFamily}}"').then(function (faces) {
    var loaded = faces.length > 0 && faces.every(function (f) { return f.status === "loaded"; });
    if (!loaded) loadInter();
  }, loadInter);
})();
</script>
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"></noscript>
{{- end}}
{{- /* The width toggle runs before the body renders so a saved wide setting
applies without a flash of the narrow column; the button behaviour is wired
through event delegation so it works on every page. */}}
<script>
(function () {
  try {
    if (localStorage.getItem("dollop-wide") === "1") {
      document.documentElement.classList.add("page-wide");
    }
  } catch (e) {}
  document.addEventListener("click", function (ev) {
    var btn = ev.target.closest ? ev.target.closest(".page-width-toggle") : null;
    if (!btn) return;
    var wide = document.documentElement.classList.toggle("page-wide");
    btn.setAttribute("aria-pressed", wide ? "true" : "false");
    try { localStorage.setItem("dollop-wide", wide ? "1" : "0"); } catch (e) {}
  });
  document.addEventListener("DOMContentLoaded", function () {
    var btn = document.querySelector(".page-width-toggle");
    if (btn) btn.setAttribute("aria-pressed",
      document.documentElement.classList.contains("page-wide") ? "true" : "false");
  });
})();
</script>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" class="md-icon-symbols" width="0" height="0" aria-hidden="true">
  <symbol id="dollop-md-icon" viewBox="0 0 24 24">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M7 15v-6l2 2l2 -2v6" />
    <path d="M14 13l2 2l2 -2m-2 2v-6" style="stroke: var(--md-icon-arrow, currentColor)" />
  </symbol>
</svg>
<header class="page-header">
  <button type="button" class="page-width-toggle" aria-pressed="false" title="Toggle page width">wide</button>
  <a href="{{.SourcePath}}" aria-label="Markdown source" title="Markdown source"><svg class="md-icon page-header-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="16" viewBox="2 4 20 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#dollop-md-icon" width="24" height="24" /></svg></a>
  <a href="https://github.com/jamestelfer/dollop"><picture>
    <source media="(prefers-color-scheme: dark)" srcset="{{.LogoDarkPath}}">
    <img src="{{.LogoLightPath}}" alt="dollop logo">
  </picture></a>
</header>
<div class="page-content">
{{- with .TOC}}
<details class="page-toc-inline">
<summary>On this page</summary>
{{template "toc-list" .}}
</details>
{{- end}}
<div class="markdown-body">
{{.Body}}
</div>
</div>
{{- with .TOC}}
<aside class="page-toc-column">
<nav class="page-toc" aria-label="On this page">
<p class="page-toc-title">On this page</p>
<div class="page-toc-track">
{{template "toc-list" .}}
</div>
</nav>
</aside>
<script src="{{$.TOCScriptPath}}" defer></script>
{{- end}}
{{- if .MermaidScript}}
{{.MermaidScript}}
{{- end}}
</body>
</html>
{{define "toc-list"}}<ul class="page-toc-list">
{{- range .}}
<li><a class="page-toc-link" href="#{{.ID}}" data-depth="{{.Depth}}">{{.Text}}</a></li>
{{- end}}
</ul>{{end}}
