<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<link rel="icon" type="image/svg+xml" href="{{.FaviconPath}}">
<link rel="stylesheet" href="{{.CSSPath}}">
<link rel="stylesheet" href="{{.ThemeCSSPath}}">
<link rel="stylesheet" href="{{.LayoutCSSPath}}">
<link rel="stylesheet" href="{{.HighlightCSSPath}}">
{{- with .FontStylesheet}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{.}}">
{{- end}}
{{- if .FontFamily}}
<style>
{{.FontFaceCSS}}
</style>
{{- /* Inter is the fallback body font. It is requested only when the shared
body font fails to load, so pages that have it make no third-party requests
and the stylesheet never blocks rendering. */}}
<script>
(function () {
  function loadInter() {
    var link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap";
    document.head.appendChild(link);
  }
  if (!document.fonts || !document.fonts.load) { loadInter(); return; }
  document.fonts.load('1em "{{.FontFamily}}"').then(function (faces) {
    var loaded = faces.length > 0 && faces.every(function (f) { return f.status === "loaded"; });
    if (!loaded) loadInter();
  }, loadInter);
})();
</script>
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"></noscript>
{{- end}}
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" class="md-icon-symbols" width="0" height="0" aria-hidden="true">
  <symbol id="dollop-md-icon" viewBox="0 0 24 24">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M7 15v-6l2 2l2 -2v6" />
    <path d="M14 13l2 2l2 -2m-2 2v-6" />
  </symbol>
</svg>
<header class="page-header">
  <a href="{{.SourcePath}}" aria-label="Markdown source" title="Markdown source"><svg class="md-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#dollop-md-icon" /></svg></a>
  <a href="https://github.com/jamestelfer/dollop"><picture>
    <source media="(prefers-color-scheme: dark)" srcset="{{.LogoDarkPath}}">
    <img src="{{.LogoLightPath}}" alt="dollop logo">
  </picture></a>
</header>
<div class="page-content">
<div class="markdown-body">
{{.Body}}
</div>
</div>
{{- if .MermaidScript}}
{{.MermaidScript}}
{{- end}}
</body>
</html>
