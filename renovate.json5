{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Floats on chinmina/.github's default branch by design: a shared-config
    // fix reaches every consuming repo without a migration. Do not pin.
    "github>chinmina/.github//renovate/shared.json5",
  ],
  // Repo-specific rules only. Order broad -> narrow: grouping rules first,
  // narrowing overrides (pinDigests, enabled, allowedVersions, single-dependency
  // exceptions) last. The ordering is intentional -- last match wins per-option.
  // mermaid.sha512 is filled in by .github/workflows/mermaid-integrity.yml once
  // provenance verifies; that workflow's commits must not mark the PR as edited.
  customManagers: [
    {
      customType: "regex",
      description: "Track the pinned mermaid engine published by `dollop deps publish`.",
      managerFilePatterns: ["/^internal/render/mermaid\\.version$/"],
      matchStrings: ["^(?<currentValue>\\S+)\\s*$"],
      datasourceTemplate: "npm",
      depNameTemplate: "mermaid",
    },
  ],
  gitIgnoredAuthors: ["41898282+github-actions[bot]@users.noreply.github.com"],
  packageRules: [],
}
